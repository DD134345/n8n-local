# ==============================================================================
# Victoria TL3 - n8n Local & Agentic Workflow Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_DB=n8n

# ------------------------------------------------------------------------------
# 2. n8n Core & Security Settings
# ------------------------------------------------------------------------------
# Generate encryption key: openssl rand -hex 32
N8N_ENCRYPTION_KEY=YOUR_N8N_ENCRYPTION_KEY_HERE
COMPOSE_PROJECT_NAME=victoria-tl3
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# ------------------------------------------------------------------------------
# 3. Local & Hosted LLM Configuration
# ------------------------------------------------------------------------------
# Local Ollama URL (default container service: http://ollama:11434)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# Fallback Hosted LLMs (Optional slots)
GOOGLE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# ------------------------------------------------------------------------------
# 4. Google Sheets & School Email (SMTP)
# ------------------------------------------------------------------------------
# Sheet ID: Found in Google Sheet URL (/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# Google OAuth2 Credentials (for Sheets only)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# School mail server. Outbound only - the system never reads a mailbox and never
# auto-replies to a parent. Ask the school's IT provider for these values.
SMTP_HOST=mail.victoria-thanglong3.edu.vn
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER_HERE
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
SMTP_SSL=false
# Address staff will see as the sender. Also set SMTP_FROM in the Config tab of the Sheet.
SMTP_FROM=no-reply@victoria-thanglong3.edu.vn

# ------------------------------------------------------------------------------
# 5. School CMS & Publication Endpoints
# ------------------------------------------------------------------------------
CMS_TYPE=wordpress
WORDPRESS_URL=https://victoria-thanglong3.edu.vn
WORDPRESS_USER=YOUR_WORDPRESS_USER_HERE
WORDPRESS_APP_PASSWORD=YOUR_WORDPRESS_APPLICATION_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 6. n8n API (for Master Orchestrator System Health)
# ------------------------------------------------------------------------------
# Create in n8n UI -> Settings -> API -> Create API Key
N8N_API_KEY=YOUR_N8N_API_KEY_HERE

# ------------------------------------------------------------------------------
# 7. Agent Long-Term Memory (Optional - Phase 4)
# ------------------------------------------------------------------------------
MEMORY_PROXY_URL=http://localhost:8088
MEMORY_API_KEY=YOUR_MEMORY_API_KEY_HERE
MEMORY_COLLECTION=victoria-tl3-drafts
