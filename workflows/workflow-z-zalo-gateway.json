    {
      "id": "z-6",
      "name": "Định tuyến tin nhắn",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Code node \"Định tuyến tin nhắn\": decide what to do with each Zalo message.\n// Inputs: $('Tách cập nhật').all() (messages), $('Đọc Config').all(), $('Đọc Nhân sự').all()\nconst noAcc = (s) => String(s ?? '').normalize('NFC').replace(/đ/g, 'd').replace(/Đ/g, 'D')\n  .normalize('NFD').replace(/[̀-ͯ]/g, '').normalize('NFC');\nconst low = (s) => noAcc(s).toLowerCase();\n\nconst cfg = {};\nfor (const it of $('Đọc Config').all()) {\n  const k = String(it.json['Key'] ?? '').trim();\n  if (k) cfg[k] = String(it.json['Value'] ?? '').trim();\n}\nconst botName = cfg.ZALO_BOT_NAME || '';\n\nconst roleOf = (r) => {\n  const v = low(r);\n  if (v.includes('quan tri') || v.includes('admin')) return 'admin';\n  if (v.includes('duyet')) return 'approver';\n  if (v.includes('nhap')) return 'entry';\n  return '';\n};\nconst active = (v) => !['false', 'khong', 'no', '0', 'ngung'].includes(low(v).trim());\nconst staff = new Map();\nfor (const it of $('Đọc Nhân sự').all()) {\n  const j = it.json;\n  const id = String(j['Zalo ID'] ?? '').trim();\n  if (!id || !active(j['Đang dùng'])) continue;\n  staff.set(id, { name: String(j['Họ tên'] ?? '').trim() || id, role: roleOf(j['Vai trò']), campus: String(j['Cơ sở'] ?? '').trim() });\n}\n\nconst HELP = [\n  'Các lệnh dùng được:',\n  '• thực đơn 06/10: <nội dung thực đơn>  (gửi thực đơn một ngày)',\n  '• duyệt 12  (người duyệt: duyệt hàng 12)',\n  '• trả lại 12 <lý do>  (người duyệt: trả lại hàng 12)',\n  '• trợ giúp',\n].join('\\n');\nconst PHONE = /(?:\\+?84|0)(?:\\d[\\s.-]?){8,10}\\d/;\nconst now = new Date();\n\nfunction parseDate(d, m, y) {\n  d = Number(d); m = Number(m);\n  if (!(d >= 1 && d <= 31 && m >= 1 && m <= 12)) return null;\n  let year = y ? Number(y.length === 2 ? `20${y}` : y) : now.getFullYear();\n  if (!y) { // no year: pick the year that puts the date nearest to today\n    const cand = new Date(year, m - 1, d);\n    if ((now - cand) / 86400000 > 180) year += 1;\n  }\n  return `${String(d).padStart(2, '0')}/${String(m).padStart(2, '0')}/${year}`;\n}\n\nconst out = [];\nfor (const it of $('Tách cập nhật').all()) {\n  const u = it.json;\n  const person = staff.get(String(u.from_id));\n  const base = { chat_id: u.chat_id, from_id: u.from_id, from_name: u.from_name, chat_type: u.chat_type };\n\n  // Hard rule 1: never reply to anyone who is not on the staff list (could be a parent).\n  if (!person) { out.push({ json: { ...base, action: 3, action_name: 'unknown', reply: '' } }); continue; }\n\n  let text = String(u.text ?? '').normalize('NFC');\n  if (botName) text = text.split(`@${botName}`).join(' ');\n  text = text.replace(/^\\s*@\\S+\\s*/, '').trim();\n  const norm = low(text);\n  const who = `${person.name} (Zalo ${u.from_id})`;\n  const reply = (r) => out.push({ json: { ...base, action: 2, action_name: 'reply', reply: r } });\n\n  if (u.event === 'message.image.received') { reply('Bản thử chưa nhận ảnh qua Zalo. Ảnh cho website xin gửi vào thư mục ảnh của trường.'); continue; }\n  if (!text) { reply(HELP); continue; }\n\n  let m;\n  if ((m = norm.match(/^thuc\\s*don\\s+(\\d{1,2})[/.-](\\d{1,2})(?:[/.-](\\d{2,4}))?\\s*[:\\-–]?\\s*([\\s\\S]*)$/))) {\n    if (!['entry', 'approver', 'admin'].includes(person.role)) { reply('Bạn chưa được phân quyền nhập thực đơn.'); continue; }\n    const date = parseDate(m[1], m[2], m[3]);\n    const content = text.slice(text.length - m[4].length).trim();\n    if (!date) { reply('Ngày không hợp lệ. Ví dụ: thực đơn 06/10: Sáng: cháo thịt…'); continue; }\n    if (content.length < 5) { reply('Thiếu nội dung thực đơn. Ví dụ: thực đơn 06/10: Sáng: cháo thịt…'); continue; }\n    if (PHONE.test(content)) { reply('Nội dung có số điện thoại nên đã được giữ lại, chưa ghi vào bảng tính. Vui lòng bỏ thông tin cá nhân rồi gửi lại.'); continue; }\n    out.push({ json: { ...base, action: 0, action_name: 'menu', date, content: content.slice(0, 4000), entered_by: `${person.name} (Zalo)`,\n      reply: `Đã nhận thực đơn ngày ${date}. Bản nháp sẽ được gửi cho người duyệt.` } });\n    continue;\n  }\n  if ((m = norm.match(/^duyet\\s+(?:hang\\s+)?(\\d{1,5})\\s*$/))) {\n    if (!['approver', 'admin'].includes(person.role)) { reply('Bạn chưa được phân quyền duyệt.'); continue; }\n    out.push({ json: { ...base, action: 1, action_name: 'approve', row_number: Number(m[1]), approver: who } });\n    continue;\n  }\n  if ((m = norm.match(/^tra\\s*lai\\s+(?:hang\\s+)?(\\d{1,5})\\s*([\\s\\S]*)$/))) {\n    if (!['approver', 'admin'].includes(person.role)) { reply('Bạn chưa được phân quyền duyệt.'); continue; }\n    const reason = text.slice(text.length - m[2].length).trim() || '(không ghi lý do)';\n    out.push({ json: { ...base, action: 1, action_name: 'reject', row_number: Number(m[1]), approver: who, reason } });\n    continue;\n  }\n  reply(norm.startsWith('tro giup') || norm === 'help' ? HELP : `Chưa hiểu yêu cầu.\\n\\n${HELP}`);\n}\nreturn out;\n"
      }
    },
