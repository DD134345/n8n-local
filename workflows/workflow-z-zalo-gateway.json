    {
      "id": "z-11",
      "name": "Kiểm tra hàng",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        0
      ],
      "parameters": {
        "jsCode": "const truthy = (v) => v === true || String(v).trim().toUpperCase() === 'TRUE';\nconst rows = new Map($input.all().map((r) => [Number(r.json.row_number), r.json]));\nconst out = [];\nfor (const it of $('Theo hành động').all(1)) {\n  const a = it.json;\n  const r = rows.get(Number(a.row_number));\n  let ok = false, reply;\n  if (!r || !String(r['Ngày'] ?? '').trim()) reply = `Không có hàng ${a.row_number} trong bảng Thực đơn.`;\n  else if (truthy(r['Đã đăng'])) reply = `Hàng ${a.row_number} (ngày ${r['Ngày']}) đã đăng rồi.`;\n  else if (a.action_name === 'approve' && truthy(r['Duyệt'])) reply = `Hàng ${a.row_number} đã được duyệt trước đó.`;\n  else if (a.action_name === 'approve' && !String(r['Bản website'] ?? '').trim()) reply = `Hàng ${a.row_number} chưa có bản nháp nên chưa duyệt được.`;\n  else {\n    ok = true;\n    reply = a.action_name === 'approve'\n      ? `Đã duyệt hàng ${a.row_number} (thực đơn ngày ${r['Ngày']}). Hệ thống sẽ đăng trong ít phút.`\n      : `Đã trả lại hàng ${a.row_number}. Lý do: ${a.reason}. Người nhập sửa trên bảng tính hoặc gửi lại.`;\n  }\n  const note = a.action_name === 'reject' ? [String(r?.['Ghi chú'] ?? '').trim(), `Trả lại bởi ${a.approver}: ${a.reason}`].filter(Boolean).join(' | ') : '';\n  out.push({ json: { ...a, ok, reply, note, route: ok ? (a.action_name === 'approve' ? 0 : 1) : 2 } });\n}\nreturn out;"
      }
    },
