    {
      "id": "z-23",
      "name": "Mỗi hàng một lần",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        520
      ],
      "parameters": {
        "jsCode": "// Mark a row as notified once at least one approver received it (failed sends retry next run).\nconst done = new Set();\n$input.all().forEach((it, i) => { if (it.json && it.json.ok === true) done.add($('Chọn bản nháp cần báo').itemMatching(i).json.row_number); });\nreturn [...done].map((row_number) => ({ json: { row_number } }));"
      }
    },
