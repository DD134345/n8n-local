    {
      "id": "z-21",
      "name": "Chọn bản nháp cần báo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        520
      ],
      "parameters": {
        "jsCode": "const noAcc = (s) => String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/đ/g, 'd').toLowerCase();\nconst truthy = (v) => v === true || String(v).trim().toUpperCase() === 'TRUE';\nconst active = (v) => !['false', 'khong', 'no', '0', 'ngung'].includes(noAcc(v).trim());\nconst strip = (h) => String(h ?? '').replace(/<br\\s*\\/?>/gi, '\\n').replace(/<\\/(p|li|h\\d)>/gi, '\\n').replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/\\n{3,}/g, '\\n\\n').trim();\nconst cut = (s, n) => (s.length > n ? s.slice(0, n - 1) + '…' : s);\nconst approvers = $('Đọc Nhân sự (báo)').all().map((i) => i.json).filter((j) => {\n  const r = noAcc(j['Vai trò']);\n  return active(j['Đang dùng']) && (r.includes('duyet') || r.includes('quan tri')) && String(j['Zalo chat ID'] || j['Zalo ID'] || '').trim();\n});\nconst out = [];\nfor (const r of $('Đọc Thực đơn (báo)').all().map((i) => i.json)) {\n  if (!String(r['Bản website'] ?? '').trim() || truthy(r['Duyệt']) || truthy(r['Đã đăng']) || String(r['Đã báo Zalo'] ?? '').trim()) continue;\n  const msg = [\n    `Bản nháp thực đơn ngày ${r['Ngày']} (hàng ${r.row_number})`,\n    `Người nhập: ${r['Người nhập'] || ''}`, '',\n    '— Bản website —', cut(strip(r['Bản website']), 900), '',\n    '— Bản Zalo —', cut(strip(r['Bản Zalo']), 450), '',\n    `Trả lời: duyệt ${r.row_number}`, `hoặc: trả lại ${r.row_number} <lý do>`,\n  ].join('\\n');\n  for (const a of approvers) out.push({ json: { chat_id: String(a['Zalo chat ID'] || a['Zalo ID']).trim(), reply: msg.slice(0, 2000), row_number: r.row_number } });\n}\nreturn out;"
      }
    },
