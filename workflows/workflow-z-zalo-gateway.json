      "onError": "continueRegularOutput"
    },
    {
      "id": "z-3",
      "name": "Tách cập nhật",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Normalise getUpdates (one update or a list) into one item per human message.\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  if (r.ok === false || r.error) continue;\n  const list = r.result === undefined || r.result === null ? [] : (Array.isArray(r.result) ? r.result : [r.result]);\n  for (const u of list) {\n    const m = u && u.message;\n    if (!m || (m.from && m.from.is_bot)) continue;\n    out.push({ json: {\n      event: u.event_name || '', message_id: m.message_id,\n      chat_id: String((m.chat && m.chat.id) ?? ''), chat_type: (m.chat && m.chat.chat_type) || '',\n      from_id: String((m.from && m.from.id) ?? ''), from_name: (m.from && (m.from.display_name || m.from.name)) || '',\n      text: m.text ?? m.caption ?? '', photo_url: m.photo_url || '',\n    } });\n  }\n}\nreturn out.filter((i) => i.json.chat_id && i.json.from_id);"
      }
    },
