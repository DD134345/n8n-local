      "notesInFlow": true,
      "notes": "Chạy khi bất kỳ workflow nào đặt errorWorkflow = workflow này bị lỗi. Không để lỗi nào âm thầm."
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "[YOUR_GOOGLE_SHEET_ID]",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Config",
          "mode": "list",
          "cachedResultName": "Config"
        },
        "options": {
          "range": "A:D"
        }
      },
      "id": "h1000001-0001-4000-8000-000000000002",
      "name": "Read Config Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        340
      ],
      "executeOnce": true,
      "notesInFlow": true,
      "notes": "Đọc tab Config của Google Sheet. Thay cho $vars (n8n Community không có biến tùy chỉnh).",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "[YOUR_GOOGLE_SHEETS_CREDENTIAL_ID]",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = {};\nfor (const item of $input.all()) {\n  const key = item.json['Key'] ?? item.json['Kho\\u00e1'] ?? item.json['Kh\\u00f3a'];\n  if (key === undefined || key === null || String(key).trim() === '') continue;\n  const value = item.json['Value'] ?? item.json['Gi\\u00e1 tr\\u1ecb'] ?? '';\n  cfg[String(key).trim()] = typeof value === 'string' ? value.trim() : value;\n}\n\nreturn [{ json: cfg }];\n"
      },
      "id": "h1000001-0001-4000-8000-000000000003",
      "name": "Read Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        340
      ],
      "notesInFlow": true,
      "notes": "Gộp các dòng Key/Value thành một object để các node sau gọi qua $('Read Config')."
    },
    {
      "parameters": {
        "jsCode": "const err = $('Error Trigger').first().json;\nconst cfg = $('Read Config').first().json;\nconst mailOk = Boolean(String(cfg.ADMIN_EMAIL || '').trim() && String(cfg.SMTP_FROM || '').trim());\nreturn [{\n  json: {\n    Timestamp: $now.setZone('Asia/Ho_Chi_Minh').toFormat('dd/MM/yyyy HH:mm:ss'),\n    Workflow: err.workflow?.name || 'Unknown',\n    Status: 'ERROR',\n    mail_ok: mailOk,\n    'Last Run': $now.setZone('Asia/Ho_Chi_Minh').toFormat('dd/MM/yyyy HH:mm:ss'),\n    Details: [\n      err.execution?.lastNodeExecuted ? 'Node: ' + err.execution.lastNodeExecuted : null,\n      err.execution?.error?.message || null,\n      err.execution?.url || null,\n      mailOk ? null : 'Thiếu ADMIN_EMAIL/SMTP_FROM trong Config - chưa gửi được email',\n    ].filter(Boolean).join(' | '),\n  },\n}];\n"
      },
      "id": "h1000001-0001-4000-8000-000000000004",
