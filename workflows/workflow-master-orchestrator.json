{
  "name": "Master Orchestrator - System Health & Coordination",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "m1000001-0001-4000-8000-000000000001",
      "name": "Cron - Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        340
      ],
      "notesInFlow": true,
      "notes": "Runs every 6 hours to check system health"
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "[YOUR_GOOGLE_SHEET_ID]",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Config",
          "mode": "list",
          "cachedResultName": "Config"
        },
        "options": {
          "range": "A:D"
        }
      },
      "id": "m1000001-0001-4000-8000-000000000011",
      "name": "Read Config Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        340
      ],
      "executeOnce": true,
      "notesInFlow": true,
      "notes": "Đọc tab Config của Google Sheet. Thay cho $vars (n8n Community không có biến tùy chỉnh).",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "[YOUR_GOOGLE_SHEETS_CREDENTIAL_ID]",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = {};\nfor (const item of $input.all()) {\n  const key = item.json['Key'] ?? item.json['Kho\\u00e1'] ?? item.json['Kh\\u00f3a'];\n  if (key === undefined || key === null || String(key).trim() === '') continue;\n  const value = item.json['Value'] ?? item.json['Gi\\u00e1 tr\\u1ecb'] ?? '';\n  cfg[String(key).trim()] = typeof value === 'string' ? value.trim() : value;\n}\n\nreturn [{ json: cfg }];\n"
      },
      "id": "m1000001-0001-4000-8000-000000000012",
      "name": "Read Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        340
      ],
      "notesInFlow": true,
      "notes": "Gộp các dòng Key/Value thành một object để các node sau gọi qua $('Read Config')."
    },
    {
      "parameters": {
        "url": "http://localhost:5678/api/v1/executions?limit=50&status=error",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "m1000001-0001-4000-8000-000000000002",
      "name": "HTTP - Get Failed Executions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        240
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "[YOUR_N8N_API_CREDENTIAL_ID]",
          "name": "n8n API Key"
        }
      },
      "notesInFlow": true,
      "notes": "Requires n8n API key.\nSettings → API → Create API Key"
    },
    {
      "parameters": {
        "url": "=http://localhost:5678/api/v1/workflows?active=true",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "m1000001-0001-4000-8000-000000000003",
      "name": "HTTP - Get Active Workflows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        460
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "[YOUR_N8N_API_CREDENTIAL_ID]",
          "name": "n8n API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Combine data from sequential execution\nconst failedNodeData = $('HTTP - Get Failed Executions').first()?.json || {};\nconst activeNodeData = $('HTTP - Get Active Workflows').first()?.json || {};\n\nconst failedExecutions = (failedNodeData.data || []).filter(e => e.status === \"error\" || e.status === \"crashed\");\nconst activeWorkflows = (activeNodeData.data || []).filter(w => w.active === true);\n\nconst issues = [];\nif (failedExecutions.length > 0) {\n  issues.push(`${failedExecutions.length} workflow execution error(s) found in past 6h`);\n}\n\nconst report = {\n  timestamp: new Date().toISOString(),\n  active_workflow_count: activeWorkflows.length,\n  failed_execution_count: failedExecutions.length,\n  has_issues: failedExecutions.length > 0,\n  failed_details: failedExecutions.map(e => ({\n    id: e.id,\n    workflowId: e.workflowId,\n    mode: e.mode,\n    startedAt: e.startedAt,\n    stoppedAt: e.stoppedAt\n  })),\n  summary: failedExecutions.length > 0\n    ? `SYSTEM WARNING: ${failedExecutions.length} executions failed in the last 6 hours.`\n    : \"SYSTEM HEALTHY: All active workflows running without errors.\"\n};\n\nreturn [{ json: report }];"
      },
      "id": "m1000001-0001-4000-8000-000000000004",
      "name": "Build Health Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-issues",
              "leftValue": "={{ $json.has_issues === true || String($json.has_issues).toLowerCase() === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "m1000001-0001-4000-8000-000000000005",
      "name": "IF - Has Issues",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        340
      ]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "Bạn là kỹ sư DevOps theo dõi hệ thống tự động hoá Victoria TL3.\n\nNhiệm vụ: Phân tích báo cáo sức khỏe hệ thống và tạo thông báo cảnh báo bằng tiếng Việt.\n\nBáo cáo cần:\n1. Tóm tắt tình trạng: workflow nào bị lỗi, workflow nào thiếu\n2. Nguyên nhân có thể (dựa trên error message)\n3. Bước khắc phục cụ thể\n4. Mức độ khẩn cấp: Thấp (thông tin) / Trung bình (cần xem) / Cao (cần sửa ngay)\n\nGiọng văn: kỹ thuật, ngắn gọn, hành động được."
        },
        "promptType": "define",
        "text": "=Phân tích báo cáo sức khỏe hệ thống:\n\n{{ JSON.stringify($json, null, 2) }}\n\nTạo thông báo cảnh báo ngắn gọn bằng HTML."
      },
      "id": "m1000001-0001-4000-8000-000000000006",
      "name": "AI Agent - Diagnose Issues",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        1680,
        240
      ]
    },
    {
      "parameters": {
        "model": "qwen2.5:7b",
        "baseUrl": "http://ollama:11434",
        "options": {
          "temperature": 0.2,
          "numCtx": 4096
        }
      },
      "id": "m1000001-0001-4000-8000-000000000007",
      "name": "Ollama Model - Diagnostics",
      "type": "@n8n/n8n-nodes-langchain.lmOllama",
      "typeVersion": 1,
      "position": [
        1580,
        440
      ],
      "credentials": {
        "ollamaApi": {
          "id": "[YOUR_OLLAMA_CREDENTIAL_ID]",
          "name": "Ollama Local"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ ($('Read Config')?.first()?.json?.SMTP_FROM || 'no-reply@victoria.edu.vn') || 'no-reply@victoria.edu.vn' }}",
        "toEmail": "={{ ($('Read Config')?.first()?.json?.ADMIN_EMAIL || 'admin@victoria.edu.vn') || 'admin@victoria.edu.vn' }}",
        "subject": "=[HỆ THỐNG] Cảnh báo Victoria TL3 - {{ $('Build Health Report').first().json.overall_status }}",
        "emailFormat": "html",
        "html": "=<h2>⚙️ Báo cáo sức khỏe hệ thống Victoria TL3</h2>\n<p><strong>Thời gian:</strong> {{ $('Build Health Report').first().json.timestamp }}</p>\n<p><strong>Trạng thái tổng thể:</strong> {{ $('Build Health Report').first().json.overall_status }}</p>\n<p><strong>Lỗi trong 24h:</strong> {{ $('Build Health Report').first().json.recent_failures_24h }}</p>\n<p><strong>Workflow đang thiếu:</strong> {{ $('Build Health Report').first().json.missing_workflows.join(', ') || 'Không có' }}</p>\n<hr>\n<h3>Phân tích AI:</h3>\n<div>{{ $json.output || $json.text || 'Không thể tạo phân tích' }}</div>\n<hr>\n<p><em>Email tự động từ Master Orchestrator.</em></p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "m1000001-0001-4000-8000-000000000008",
      "name": "Email - System Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1940,
        240
      ],
      "credentials": {
        "smtp": {
          "id": "[YOUR_SMTP_CREDENTIAL_ID]",
          "name": "Victoria School SMTP"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "[YOUR_GOOGLE_SHEET_ID]",
          "mode": "id"
        },
        "sheetName": {
