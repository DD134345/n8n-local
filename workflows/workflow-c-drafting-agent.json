    {
      "parameters": {
        "options": {
          "systemMessage": "=Bạn là chuyên gia nội dung giáo dục cho Trường Victoria Thăng Long 3.\n\nNhiệm vụ: Từ nội dung thô được cung cấp, hãy tạo BA phiên bản:\n\n1. **Bản website** (HTML):\n   - Dùng thẻ HTML cơ bản (<h3>, <p>, <ul>, <li>)\n   - Giọng văn trang trọng, chuyên nghiệp\n   - Bao gồm tiêu đề rõ ràng\n\n2. **Bản Zalo** (plain text):\n   - Không dùng HTML\n   - Xuống dòng rõ ràng\n   - Giọng thân thiện, dễ đọc trên điện thoại\n   - Bắt đầu bằng emoji phù hợp (🍽️ cho thực đơn, 📢 cho thông báo)\n\n3. **Bản Facebook** (social media):\n   - Giọng năng động, gần gũi\n   - Hashtag cuối bài: #VictoriaThangLong3 #VictoriaSchool\n   - Emoji phù hợp trong bài\n\nTrả lời CHÍNH XÁC theo format JSON sau (không thêm markdown code block):\n{\"ban_website\": \"...\", \"ban_zalo\": \"...\", \"ban_facebook\": \"...\"}\n\nNội dung hôm nay: {{ $json['Nội dung'] }}\nNgày: {{ $json['Ngày'] }}"
        },
        "promptType": "define",
        "text": "=Hãy tạo 3 phiên bản nội dung cho ngày {{ $json['Ngày'] }}.\n\nNội dung gốc:\n{{ $json['Nội dung'] }}\n\nNgười nhập: {{ $json['Người nhập'] }}"
      },
      "id": "c1000001-0001-4000-8000-000000000005",
      "name": "AI Agent - Gemini Fallback",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [700, 540]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {
          "temperature": 0.7,
          "maxOutputTokens": 2048
        }
      },
      "id": "c1000001-0001-4000-8000-000000000006",
      "name": "Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmGoogleGemini",
      "typeVersion": 1,
      "position": [600, 720],
      "credentials": {
        "googleGeminiApi": {
          "id": "CREDENTIAL_ID_GEMINI",
          "name": "Gemini API Free"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI agent output (JSON string) into structured fields\nconst items = $input.all();\nconst sourceItems = $('IF - Drafts Empty').all();\nconst results = [];\n\nfor (let index = 0; index < items.length; index++) {\n  const item = items[index];\n  let output = item.json.output || item.json.text || '';\n  \n  // Try to extract JSON from the response\n  let parsed;\n  try {\n    parsed = JSON.parse(output);\n  } catch (e) {\n    const jsonMatch = output.match(/\\{[\\s\\S]*?\"ban_website\"[\\s\\S]*?\\}/);\n    if (jsonMatch) {\n      try {\n        parsed = JSON.parse(jsonMatch[0]);\n      } catch (e2) {\n        parsed = {\n          ban_website: output,\n          ban_zalo: output,\n          ban_facebook: output\n        };\n      }\n    } else {\n      parsed = {\n        ban_website: output,\n        ban_zalo: output,\n        ban_facebook: output\n      };\n    }\n  }\n  \n  // Recover row_number from the IF node's true-branch items\n  // (the agent drops input fields, so we look up the source row)\n  const srcIndex = Math.min(index, sourceItems.length - 1);\n  const rowNumber = sourceItems[srcIndex]?.json?.row_number ?? '';\n  \n  results.push({\n    json: {\n      ban_website: parsed.ban_website || '',\n      ban_zalo: parsed.ban_zalo || '',\n      ban_facebook: parsed.ban_facebook || '',\n      row_number: rowNumber\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "c1000001-0001-4000-8000-000000000007",
