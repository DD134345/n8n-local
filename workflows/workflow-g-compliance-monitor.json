        }
      },
      "id": "g1000001-0001-4000-8000-000000000015",
      "name": "Read Weekly Compliance",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 800],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "[YOUR_GOOGLE_SHEETS_CREDENTIAL_ID]",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "Bạn là chuyên gia tuân thủ giáo dục cho hệ thống trường Victoria.\n\nNhiệm vụ: Tạo báo cáo tổng hợp tuần về tình trạng tuân thủ website, gửi cho Ban Giám đốc.\n\nBáo cáo cần:\n1. Điểm tuân thủ tổng thể (% URL đạt)\n2. Xu hướng so với tuần trước (nếu có)\n3. Vấn đề cần lưu ý\n4. Đề xuất hành động\n\nFormat: HTML đẹp, chuyên nghiệp, phù hợp email gửi lãnh đạo."
        },
        "promptType": "define",
        "text": "=Tạo báo cáo tuần về tuân thủ website Victoria TL3.\n\nDữ liệu hiện tại:\n{{ JSON.stringify($input.all().map(i => i.json), null, 2) }}\n\nHãy tạo báo cáo HTML chuyên nghiệp để gửi Ban Giám đốc."
      },
      "id": "g1000001-0001-4000-8000-000000000016",
      "name": "AI Agent - Weekly Summary",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [680, 800]
    },
    {
      "parameters": {
        "model": "qwen2.5:7b",
        "baseUrl": "http://ollama:11434",
        "options": {
          "temperature": 0.3,
          "numCtx": 4096
        }
      },
      "id": "g1000001-0001-4000-8000-000000000017",
      "name": "Ollama Model - Weekly",
      "type": "@n8n/n8n-nodes-langchain.lmOllama",
      "typeVersion": 1,
      "position": [580, 1000],
      "credentials": {
        "ollamaApi": {
          "id": "[YOUR_OLLAMA_CREDENTIAL_ID]",
          "name": "Ollama Local"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $vars.BGD_EMAIL || 'bgd@victoria.edu.vn' }}",
        "subject": "=[BÁO CÁO TUẦN] Tuân thủ website Victoria - Tuần {{ new Date().toLocaleDateString('vi-VN') }}",
        "emailType": "html",
        "message": "={{ $json.output || $json.text || 'Không thể tạo báo cáo' }}",
        "options": {}
      },
      "id": "g1000001-0001-4000-8000-000000000018",
      "name": "Gmail - Weekly Report to BGD",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [920, 800],
      "credentials": {
        "gmailOAuth2": {
