    {
      "parameters": {
        "fromEmail": "={{ ($('Read Config')?.first()?.json?.SMTP_FROM || 'no-reply@victoria.edu.vn') || 'no-reply@victoria.edu.vn' }}",
        "toEmail": "={{ ($('Read Config')?.first()?.json?.ADMIN_EMAIL || 'admin@victoria.edu.vn') || 'admin@victoria.edu.vn' }}",
        "subject": "=[CẢNH BÁO] Kiểm tra tuân thủ website - {{ $json.fail_count || '' }} URL không đạt",
        "emailFormat": "html",
        "html": "=<h2>🔍 Báo cáo kiểm tra tuân thủ website Victoria TL3</h2>\n<p><strong>Thời gian:</strong> {{ $('Aggregate Results').first().json.timestamp }}</p>\n<p><strong>Tổng URL:</strong> {{ $('Aggregate Results').first().json.total }} | <strong>Đạt:</strong> {{ $('Aggregate Results').first().json.pass_count }} | <strong>Không đạt:</strong> {{ $('Aggregate Results').first().json.fail_count }}</p>\n<hr>\n<h3>Phân tích AI:</h3>\n<div>{{ $json.output || $json.text || 'Không thể tạo phân tích' }}</div>\n<hr>\n<p><em>Kiểm tra chi tiết: <a href=\"https://docs.google.com/spreadsheets/d/[YOUR_GOOGLE_SHEET_ID]/edit#gid=compliance\">Bảng Compliance</a></em></p>\n<p><em>Email tự động từ hệ thống Victoria TL3.</em></p>",
        "options": {
