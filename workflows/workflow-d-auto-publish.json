{
  "name": "D - Auto-Publish (WordPress + Manual Fallback)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "id",
          "cachedResultName": "Thực đơn"
        },
        "event": "rowUpdate",
        "options": {
          "columnsToWatch": ["Duyệt"]
        }
      },
      "id": "d1000001-0001-4000-8000-000000000001",
      "name": "Sheets Trigger - Approval Changed",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [200, 340],
      "credentials": {
        "googleSheetsTriggerOAuth2Api": {
          "id": "CREDENTIAL_ID_SHEETS",
          "name": "Google Sheets Trigger OAuth2"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-approved",
              "leftValue": "={{ $json['Duyệt'] === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "cond-not-posted",
              "leftValue": "={{ $json['Đã đăng'] !== true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1000001-0001-4000-8000-000000000002",
      "name": "IF - Approved and Not Posted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 340]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $vars.CMS_TYPE || 'wordpress' }}",
                    "rightValue": "wordpress",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": "WordPress"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $vars.CMS_TYPE || 'wordpress' }}",
                    "rightValue": "manual",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": "Manual"
            }
          ],
          "fallbackOutput": {
            "type": "extra",
            "output": "Manual Fallback"
          }
        },
        "options": {}
      },
      "id": "d1000001-0001-4000-8000-000000000003",
      "name": "Switch - CMS Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [680, 340]
    },
    {
      "parameters": {
        "url": "={{ $vars.WORDPRESS_URL || 'https://your-school-site.edu.vn' }}/wp-json/wp/v2/posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"{{ $json['Ngày'] }} - Thực đơn\",\n  \"content\": {{ JSON.stringify($json['Bản website']) }},\n  \"status\": \"publish\",\n  \"categories\": []\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "d1000001-0001-4000-8000-000000000004",
      "name": "WordPress - Create Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 220],
      "credentials": {
        "httpBasicAuth": {
          "id": "CREDENTIAL_ID_WP",
          "name": "WordPress Application Password"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-url",
              "name": "post_url",
              "value": "={{ $json.link || $json.guid?.rendered || 'Published - check site' }}",
              "type": "string"
            },
            {
              "id": "set-published",
              "name": "da_dang",
              "value": "TRUE",
              "type": "string"
            },
            {
              "id": "set-method",
              "name": "publish_method",
              "value": "WordPress API",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "d1000001-0001-4000-8000-000000000005",
      "name": "Set - WordPress Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1160, 140]
    },
    {
      "parameters": {
        "sendTo": "={{ $vars.POSTER_EMAIL || 'poster@victoria.edu.vn' }}",
        "subject": "=[CẦN ĐĂNG] {{ $json['Ngày'] }} - Thực đơn Victoria TL3",
        "emailType": "html",
        "message": "=<h2>Nội dung cần đăng lên website</h2>\n<p><strong>Ngày:</strong> {{ $json['Ngày'] }}</p>\n<p><strong>Người duyệt:</strong> {{ $json['Người duyệt'] }}</p>\n<p><strong>Thời điểm duyệt:</strong> {{ $json['Thời điểm duyệt'] }}</p>\n<hr>\n<h3>Bản website (copy & paste vào CMS):</h3>\n{{ $json['Bản website'] }}\n<hr>\n<h3>Bản Zalo:</h3>\n<pre>{{ $json['Bản Zalo'] }}</pre>\n<hr>\n<h3>Bản Facebook:</h3>\n<pre>{{ $json['Bản Facebook'] }}</pre>\n<hr>\n<p><em>Email tự động từ hệ thống Victoria TL3. Vui lòng đăng nội dung trên lên website và đánh dấu \"Đã đăng\" trong bảng tính.</em></p>",
        "options": {}
      },
      "id": "d1000001-0001-4000-8000-000000000006",
      "name": "Gmail - Manual Publish Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
