    {
      "parameters": {
        "jsCode": "// Re-check after waiting — same logic as Thursday check\nconst weekDates = $('Calculate Week Dates').first().json.week_dates;\nconst allRows = $input.all().map(item => item.json);\n\nconst stillMissing = [];\nfor (const date of weekDates) {\n  const row = allRows.find(r => r['Date'] === date);\n  if (!row || !row['Content'] || row['Content'].toString().trim() === '') {\n    stillMissing.push(date);\n  }\n}\n\nreturn [{\n  json: {\n    still_missing: stillMissing.length > 0,\n    missing_days: stillMissing,\n    missing_count: stillMissing.length\n  }\n}];"
      },
