      },
      "id": "e1000001-0001-4000-8000-000000000001",
      "name": "Cron - Thursday 8AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        340
      ],
      "notesInFlow": true,
      "notes": "Every Thursday at 08:00 ICT (UTC+7)\nAdjust cron if server timezone ≠ ICT:\n0 1 * * 4 for UTC"
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "[YOUR_GOOGLE_SHEET_ID]",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Config",
          "mode": "list",
          "cachedResultName": "Config"
        },
        "options": {
          "range": "A:D"
        }
      },
      "id": "e1000001-0001-4000-8000-000000000014",
      "name": "Read Config Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        340
      ],
      "executeOnce": true,
      "notesInFlow": true,
      "notes": "Reads the Config tab of the Google Sheet. Replaces $vars, which n8n Community edition does not have.",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "[YOUR_GOOGLE_SHEETS_CREDENTIAL_ID]",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = {};\nfor (const item of $input.all()) {\n  const key = item.json['Key'] ?? item.json['Kho\\u00e1'] ?? item.json['Kh\\u00f3a'];\n  if (key === undefined || key === null || String(key).trim() === '') continue;\n  const value = item.json['Value'] ?? item.json['Gi\\u00e1 tr\\u1ecb'] ?? '';\n  cfg[String(key).trim()] = typeof value === 'string' ? value.trim() : value;\n}\n\nreturn [{ json: cfg }];\n"
      },
      "id": "e1000001-0001-4000-8000-000000000015",
      "name": "Read Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        340
      ],
      "notesInFlow": true,
      "notes": "Folds the Key/Value rows into one object so later nodes can read it via $('Read Config')."
    },
    {
      "parameters": {
        "jsCode": "// Calculate NEXT week Monday date (Thursday/Friday reminder looks at upcoming week)\nconst now = new Date();\nconst dayOfWeek = now.getDay(); // 0 is Sun, 4 is Thu, 5 is Fri\n\n// Next Monday is (7 - dayOfWeek + 1) % 7 + (dayOfWeek === 1 ? 7 : 0)\n// If today is Thursday (4), days until next Monday = 4 days\n// If today is Friday (5), days until next Monday = 3 days\nconst daysUntilNextMonday = ((1 - dayOfWeek + 7) % 7) || 7;\nconst nextMonday = new Date(now);\nnextMonday.setDate(now.getDate() + daysUntilNextMonday);\n\n// Format DD/MM/YYYY to match Sheet format\nconst dd = String(nextMonday.getDate()).padStart(2, \"0\");\nconst mm = String(nextMonday.getMonth() + 1).padStart(2, \"0\");\nconst yyyy = nextMonday.getFullYear();\n\n// Calculate whole working week range (Mon to Fri) for searching\nconst weekDates = [];\nfor (let i = 0; i < 5; i++) {\n  const d = new Date(nextMonday);\n  d.setDate(nextMonday.getDate() + i);\n  weekDates.push(\n    String(d.getDate()).padStart(2, \"0\") + \"/\" +\n    String(d.getMonth() + 1).padStart(2, \"0\") + \"/\" +\n    d.getFullYear()\n  );\n}\n\nreturn [{\n  json: {\n    week_start: `${dd}/${mm}/${yyyy}`,\n    week_dates: weekDates,\n    check_type: dayOfWeek === 5 ? \"friday_escalation\" : \"thursday_reminder\"\n  }\n}];"
      },
      "id": "e1000001-0001-4000-8000-000000000002",
      "name": "Calculate Week Dates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        340
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "[YOUR_GOOGLE_SHEET_ID]",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "id",
          "cachedResultName": "Menu"
        },
        "options": {
          "range": "A:L"
        }
      },
      "id": "e1000001-0001-4000-8000-000000000003",
      "name": "Read Menu Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1160,
        340
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "[YOUR_GOOGLE_SHEETS_CREDENTIAL_ID]",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Check if this week's menu entries exist and have content\nconst weekDates = $('Calculate Week Dates').first().json.week_dates;\nconst allRows = $input.all().map(item => item.json);\n\nconst missingDays = [];\nconst filledDays = [];\n\nfor (const date of weekDates) {\n  const row = allRows.find(r => r['Date'] === date);\n  if (!row || !row['Content'] || row['Content'].toString().trim() === '') {\n    missingDays.push(date);\n  } else {\n    filledDays.push(date);\n  }\n}\n\nreturn [{\n  json: {\n    has_missing: missingDays.length > 0,\n    missing_days: missingDays,\n    filled_days: filledDays,\n    missing_count: missingDays.length,\n    total_days: weekDates.length,\n    summary: missingDays.length > 0\n      ? `Menu missing for ${missingDays.length}/${weekDates.length} days: ${missingDays.join(', ')}`\n      : `Full menu present for the week (${weekDates.length} days)`\n  }\n}];"
      },
      "id": "e1000001-0001-4000-8000-000000000004",
      "name": "Check Missing Menus",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-missing",
              "leftValue": "={{ $json.has_missing }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e1000001-0001-4000-8000-000000000005",
      "name": "IF - Menu Missing",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1640,
        340
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ ($('Read Config')?.first()?.json?.SMTP_FROM || 'no-reply@victoria.edu.vn') || 'no-reply@victoria.edu.vn' }}",
        "toEmail": "={{ ($('Read Config')?.first()?.json?.BAN_TRU_EMAIL || 'bantru@victoria.edu.vn') || 'bantru@victoria.edu.vn' }}",
        "subject": "=[REMINDER] This week's menu is incomplete - Victoria TL3",
        "emailFormat": "html",
        "html": "=<h2>&#128203; Menu entry reminder</h2>\n<p>Hello,</p>\n<p>The system has found that this week's menu is <strong>incomplete</strong>.</p>\n<p><strong>{{ $json.summary }}</strong></p>\n<h3>Missing days:</h3>\n<ul>\n{{ $json.missing_days.map(d => '<li>' + d + '</li>').join('\\n') }}\n</ul>\n<p>Please update the menu in the <a href=\"https://docs.google.com/spreadsheets/d/[YOUR_GOOGLE_SHEET_ID]/edit\">data sheet</a> before the end of today.</p>\n<p><em>If it is not updated before 12:00 on Friday, the system will notify the Principal.</em></p>\n<hr>\n<p><em>Automated email from the Victoria TL3 system.</em></p>",
        "options": {
          "appendAttribution": false
        }
      },
