{
  "name": "Master Orchestrator - System Health & Coordination",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "m1000001-0001-4000-8000-000000000001",
      "name": "Cron - Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        340
      ],
      "notesInFlow": true,
      "notes": "Runs every 6 hours to check system health"
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "[YOUR_GOOGLE_SHEET_ID]",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Config",
          "mode": "list",
          "cachedResultName": "Config"
        },
        "options": {
          "range": "A:D"
        }
      },
      "id": "m1000001-0001-4000-8000-000000000011",
      "name": "Read Config Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        340
      ],
      "executeOnce": true,
      "notesInFlow": true,
      "notes": "Reads the Config tab of the Google Sheet. Replaces $vars, which n8n Community edition does not have.",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "[YOUR_GOOGLE_SHEETS_CREDENTIAL_ID]",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = {};\nfor (const item of $input.all()) {\n  const key = item.json['Key'] ?? item.json['Kho\\u00e1'] ?? item.json['Kh\\u00f3a'];\n  if (key === undefined || key === null || String(key).trim() === '') continue;\n  const value = item.json['Value'] ?? item.json['Gi\\u00e1 tr\\u1ecb'] ?? '';\n  cfg[String(key).trim()] = typeof value === 'string' ? value.trim() : value;\n}\n\nconst missing = [\"SMTP_FROM\", \"ADMIN_EMAIL\", \"EXPECTED_WORKFLOWS\"].filter((k) => !String(cfg[k] ?? '').trim());\nif (missing.length) throw new Error('Config tab thiếu khoá: ' + missing.join(', '));\nreturn [{ json: cfg }];\n"
      },
      "id": "m1000001-0001-4000-8000-000000000012",
      "name": "Read Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        340
      ],
      "notesInFlow": true,
      "notes": "Folds the Key/Value rows into one object so later nodes can read it via $('Read Config')."
    },
    {
      "parameters": {
        "url": "http://localhost:5678/api/v1/executions?limit=250",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "m1000001-0001-4000-8000-000000000002",
      "name": "HTTP - Get Failed Executions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        240
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "[YOUR_N8N_API_CREDENTIAL_ID]",
          "name": "n8n API Key"
        }
      },
      "notesInFlow": true,
      "notes": "Requires n8n API key.\nSettings → API → Create API Key"
    },
    {
      "parameters": {
        "url": "http://localhost:5678/api/v1/workflows?limit=250",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "m1000001-0001-4000-8000-000000000003",
      "name": "HTTP - Get Active Workflows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        460
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "[YOUR_N8N_API_CREDENTIAL_ID]",
          "name": "n8n API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Combine data from both API calls. Figures are computed here; the model only explains them.\nconst cfg = $('Read Config').first().json;\nconst expected = String(cfg.EXPECTED_WORKFLOWS || '').split(',').map((s) => s.trim()).filter(Boolean);\nconst execs = $('HTTP - Get Failed Executions').first()?.json?.data || [];\nconst workflows = $('HTTP - Get Active Workflows').first()?.json?.data || [];\nconst byName = new Map(workflows.map((w) => [w.name, w]));\nconst ids = new Set(expected.map((n) => byName.get(n)?.id).filter(Boolean));\nconst since = Date.now() - 24 * 3600 * 1000;\nconst failed = execs.filter((e) => ['error', 'crashed'].includes(e.status) && ids.has(e.workflowId) && Date.parse(e.startedAt || e.stoppedAt || 0) >= since);\nconst missing = expected.filter((n) => !(byName.get(n) && byName.get(n).active === true));\nconst nameOf = (id) => (workflows.find((w) => w.id === id) || {}).name || id;\nconst issues = [];\nif (failed.length) issues.push(`${failed.length} failed runs in the last 24 hours`);\nif (missing.length) issues.push(`Workflows not running (inactive or missing): ${missing.join(', ')}`);\nreturn [{ json: {\n  timestamp: new Date().toISOString(),\n  overall_status: issues.length ? 'WARNING' : 'OK',\n  has_issues: issues.length > 0,\n  recent_failures_24h: failed.length,\n  missing_workflows: missing,\n  failed_details: failed.slice(0, 20).map((e) => ({ workflow: nameOf(e.workflowId), id: e.id, status: e.status, startedAt: e.startedAt })),\n  summary: issues.length ? issues.join('; ') : 'All expected workflows are active and nothing failed in the last 24 hours.',\n} }];\n"
      },
      "id": "m1000001-0001-4000-8000-000000000004",
      "name": "Build Health Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-issues",
              "leftValue": "={{ $json.has_issues === true || String($json.has_issues).toLowerCase() === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "m1000001-0001-4000-8000-000000000005",
      "name": "IF - Has Issues",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        340
      ]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are the DevOps engineer monitoring the Victoria TL3 automation system.\n\nTask: analyse the system health report and write an alert notice in English.\n\nThe notice needs:\n1. A status summary: which workflows failed, which are missing\n2. Likely causes, based on the error messages\n3. Specific remediation steps\n4. Urgency: Low (informational) / Medium (needs review) / High (fix now)\n\nTone: technical, concise, actionable."
        },
        "promptType": "define",
        "text": "=Health check result (already computed - do not change or add numbers):\n{{ $json.summary }}\n\n{{ JSON.stringify($json.failed_details, null, 2) }}\n\nExplain likely causes and fixes, briefly, as HTML."
      },
      "id": "m1000001-0001-4000-8000-000000000006",
      "name": "AI Agent - Diagnose Issues",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        1680,
        240
      ]
    },
    {
      "parameters": {
        "model": "={{ $('Read Config').first().json.OLLAMA_MODEL || 'qwen3.5:9b' }}",
        "baseUrl": "http://winhost:11434",
        "options": {
          "temperature": 0.2,
          "numCtx": 8192
        }
      },
      "id": "m1000001-0001-4000-8000-000000000007",
      "name": "Ollama Model - Diagnostics",
      "type": "@n8n/n8n-nodes-langchain.lmOllama",
      "typeVersion": 1,
      "position": [
        1580,
        440
      ],
      "credentials": {
        "ollamaApi": {
          "id": "[YOUR_OLLAMA_CREDENTIAL_ID]",
          "name": "Ollama Local"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Read Config').first().json.SMTP_FROM }}",
        "toEmail": "={{ $('Read Config').first().json.ADMIN_EMAIL }}",
        "subject": "=[SYSTEM] Victoria TL3 alert - {{ $('Build Health Report').first().json.overall_status }}",
        "emailFormat": "html",
        "html": "=<h2>&#9881; Victoria TL3 system health report</h2>\n<p><strong>Time:</strong> {{ $('Build Health Report').first().json.timestamp }}</p>\n<p><strong>Overall status:</strong> {{ $('Build Health Report').first().json.overall_status }}</p>\n<p><strong>Failures in last 24h:</strong> {{ $('Build Health Report').first().json.recent_failures_24h }}</p>\n<p><strong>Workflows missing:</strong> {{ $('Build Health Report').first().json.missing_workflows.join(', ') || 'None' }}</p>\n<p><strong>{{ $('Build Health Report').first().json.summary }}</strong></p>\n<hr>\n<h3>AI analysis:</h3>\n<div>{{ String($json.output || $json.text || '').replace(/<think>[\\s\\S]*?<\\/think>/g, '').trim() || 'Analysis unavailable' }}</div>\n<hr>\n<p><em>Automated email from the Master Orchestrator.</em></p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "m1000001-0001-4000-8000-000000000008",
      "name": "Email - System Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1940,
        240
      ],
      "credentials": {
        "smtp": {
          "id": "[YOUR_SMTP_CREDENTIAL_ID]",
          "name": "Victoria School SMTP"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
