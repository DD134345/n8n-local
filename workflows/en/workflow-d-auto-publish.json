      "id": "d1000001-0001-4000-8000-000000000011",
      "name": "Read Config Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        340
      ],
      "executeOnce": true,
      "notesInFlow": true,
      "notes": "Reads the Config tab of the Google Sheet. Replaces $vars, which n8n Community edition does not have.",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "[YOUR_GOOGLE_SHEETS_CREDENTIAL_ID]",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = {};\nfor (const item of $input.all()) {\n  const key = item.json['Key'] ?? item.json['Kho\\u00e1'] ?? item.json['Kh\\u00f3a'];\n  if (key === undefined || key === null || String(key).trim() === '') continue;\n  const value = item.json['Value'] ?? item.json['Gi\\u00e1 tr\\u1ecb'] ?? '';\n  cfg[String(key).trim()] = typeof value === 'string' ? value.trim() : value;\n}\n\n// Carry the triggering rows through so downstream nodes keep their data,\n// while $('Read Config').first().json.KEY still resolves.\nconst rows = $('Sheets Trigger - Approval Changed').all();\nif (rows.length === 0) return [{ json: cfg }];\nreturn rows.map((item, i) => ({ json: { ...cfg, ...item.json }, pairedItem: { item: i } }));\n"
      },
      "id": "d1000001-0001-4000-8000-000000000012",
      "name": "Read Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        340
      ],
      "notesInFlow": true,
      "notes": "Folds the Key/Value rows into one object so later nodes can read it via $('Read Config')."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-approved",
              "leftValue": "={{ $json[\"Approved\"] === true || String($json[\"Approved\"]).toLowerCase() === \"true\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "cond-not-posted",
              "leftValue": "={{ $json[\"Published\"] !== true && String($json[\"Published\"]).toLowerCase() !== \"true\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "cond-no-post-url",
              "leftValue": "={{ !$json[\"Post URL\"] || String($json[\"Post URL\"]).trim() === \"\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
