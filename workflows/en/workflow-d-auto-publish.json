                    "rightValue": "wordpress",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": "WordPress"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ ($('Read Config')?.first()?.json?.CMS_TYPE || 'wordpress') || 'wordpress' }}",
                    "rightValue": "manual",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": "Manual"
            }
