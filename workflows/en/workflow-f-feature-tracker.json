        200,
        340
      ],
      "notesInFlow": true,
      "notes": "POST http://localhost:5678/webhook/feature-request\nBody: { title, description, priority, requester }"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst now = new Date();\nreturn [{\n  json: {\n    'Created': now.toLocaleDateString('en-GB'),\n    'Feature name': body.title || '(untitled)',\n    'Description': body.description || '',\n    'Priority': body.priority || 'medium',\n    'Requested by': body.requester || 'dashboard',\n    'Status': 'Pending'\n  }\n}];"
      },
      "id": "f1000001-0001-4000-8000-000000000002",
      "name": "Format Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        340
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "[YOUR_GOOGLE_SHEET_ID]",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Features",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData"
        },
        "options": {}
      },
      "id": "f1000001-0001-4000-8000-000000000003",
      "name": "Append to Features Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        680,
        340
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "[YOUR_GOOGLE_SHEETS_CREDENTIAL_ID]",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ok: true, message: 'Feature request recorded' } }];"
      },
      "id": "f1000001-0001-4000-8000-000000000004",
      "name": "Respond OK",
      "type": "n8n-nodes-base.code",
