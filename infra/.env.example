# Victoria TL3 n8n Workflow System - Environment Variables
# Copy this to .env and fill in your actual values

# PostgreSQL (used by n8n)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=[YOUR_POSTGRES_PASSWORD]
POSTGRES_DB=n8n

# n8n Encryption Key (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=[YOUR_N8N_ENCRYPTION_KEY]

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=victoria-tl3

# --- API Keys (fill in later) ---

# Ollama (local, no key needed, just verify running)
# OLLAMA_BASE_URL=http://ollama:11434

# Google Sheets API
# Create at: https://console.cloud.google.com/apis/credentials
# GOOGLE_SHEETS_CLIENT_ID=[YOUR_GOOGLE_CLIENT_ID]
# GOOGLE_SHEETS_CLIENT_SECRET=[YOUR_GOOGLE_CLIENT_SECRET]

# WordPress REST API
# Create Application Passwords at: wp-admin > Users > Application Passwords
# WORDPRESS_URL=[YOUR_WORDPRESS_URL]  (e.g., https://victoria-thanglong3.edu.vn)
# WORDPRESS_USER=[YOUR_WP_USERNAME]
# WORDPRESS_APP_PASSWORD=[YOUR_WP_APPLICATION_PASSWORD]

# n8n API Key (for health checks)
# Create at: n8n Settings > API > Create API Key
# N8N_API_KEY=[YOUR_N8N_API_KEY]

# Gmail (for alerts)
# GOOGLE_GMAIL_CLIENT_ID=[YOUR_GMAIL_CLIENT_ID]
# GOOGLE_GMAIL_CLIENT_SECRET=[YOUR_GMAIL_CLIENT_SECRET]

# Google Sheet ID (the central data spreadsheet)
# GOOGLE_SHEET_ID=[YOUR_GOOGLE_SHEET_ID]
