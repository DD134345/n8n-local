# Copy this to .env on the VMware Ubuntu VM and fill in actual values.
# The root .env.example is reference only; Docker Compose never reads it.

# Windows host's VMware Network Adapter VMnet8 IPv4 address
# Find with ipconfig -> "VMware Network Adapter VMnet8".
WIN_HOST_IP=

# Stable IPv4 address of the Ubuntu VM, used to open n8n from Windows.
VM_IP=

# Optional host directory containing workflow exports for import
WORKFLOWS_IMPORT_DIR=

# PostgreSQL (used by n8n)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# n8n encryption key (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# Docker Compose project name
COMPOSE_PROJECT_NAME=victoria-tl3

# Ollama and OmniRoute run natively on Windows; add these as n8n credentials.
# Ollama base URL: http://winhost:11434
# OmniRoute base URL: http://winhost:20128/v1

# Zalo bot token for workflow Z
ZALO_BOT_TOKEN=
