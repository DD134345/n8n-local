# Copy this to .env next to compose.yaml (on the machine that runs Docker) and fill in the values.
# The root .env.example is reference only; Docker Compose never reads it.

# Windows host's VMware Network Adapter VMnet8 IPv4 address (ipconfig). Required.
# On a single Linux machine, use the host's own IP.
WIN_HOST_IP=

# Stable IPv4 address of the Ubuntu VM (ip -4 addr inside the VM). Required.
VM_IP=

# URL used for OAuth redirects and links. Keep http://localhost:5678: Google rejects plain-http
# redirects to private IPs. Connect Google credentials from a browser where localhost:5678 reaches
# n8n (the VM's own browser, or a VMware NAT port-forward 5678 -> VM_IP:5678).
N8N_PUBLIC_URL=http://localhost:5678

# Folder with generated workflow files (scripts/build-workflows.mjs writes ./import/<CAMPUS>/)
WORKFLOWS_IMPORT_DIR=./import

# PostgreSQL (used by n8n)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# n8n encryption key (generate with: openssl rand -hex 32). Back it up separately.
N8N_ENCRYPTION_KEY=

# Docker Compose project name
COMPOSE_PROJECT_NAME=victoria-tl3

# Ollama and OmniRoute run natively on Windows; add these as n8n credentials.
# Ollama base URL: http://winhost:11434  (Windows needs OLLAMA_HOST=0.0.0.0:11434 and a firewall
# rule allowing TCP 11434 from the VMnet8 subnet only)
# OmniRoute base URL: http://winhost:20128/v1

# Zalo bot tokens do NOT go here. Put them in infra/zalo.env, one line per campus:
#   ZALO_BOT_TOKEN_TL3=...
# (the build script points each campus's workflows at its own variable)
